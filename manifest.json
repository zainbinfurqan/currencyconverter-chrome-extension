{
    "version": "1.0.0",
    "manifest_version": 3,
    "name": "Content Reader",
    "description": "Extension to get answer related to your query on the bases of selected book from the list",
    "background": {
        "service_worker": "background.js"
      },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-16.png",
        "128": "icons/icon-16.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-16.png",
            "128": "icons/icon-16.png"
        },
        "default_popup": "js/index.html",
        "default_title": "Ask queries about related book"
    },
    "web_accessible_resources": [
        {
          "resources": ["assets/CA_1.png", "assets/JS_1.jpg"],
          "matches": ["<all_urls>"]
        }
      ]
}
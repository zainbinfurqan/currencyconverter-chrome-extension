{
    "version": "1.0.5",
    "manifest_version": 3,
    "name": "get url extension",
    "background": {
        "service_worker": "background.js"
      },
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-16.png",
        "128": "icons/icon-16.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-16.png",
            "128": "icons/icon-16.png"
        },
        "default_popup": "js/index.html",
        "default_title": "Ask queries about related book"
    },
    "permissions": ["activeTab", "scripting"],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
      ]
}
